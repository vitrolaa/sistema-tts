# VozLivre Server Configuration Example
PORT=3001
NODE_ENV=development

# Database configuration
# SQLite (Local Dev zero-config):
DATABASE_URL="file:./dev.db"

# PostgreSQL (Production):
# DATABASE_URL="postgresql://username:password@localhost:5432/vozlivre?schema=public"

# Storage configuration for generated audio files
AUDIO_STORAGE_PATH="./uploads/audio"

# Primary TTS Provider: "edge" | "google"
DEFAULT_TTS_PROVIDER="edge"
DEFAULT_VOICE="pt-BR-FranciscaNeural"
DEFAULT_LANGUAGE="pt-BR"

# Optional Cloud TTS Providers (Extensible Abstraction)
# OPENAI_API_KEY=""
# GOOGLE_APPLICATION_CREDENTIALS=""

# CORS Allowed Origin
CLIENT_URL="http://localhost:5173"
